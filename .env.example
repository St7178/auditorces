# OpenAI API key used by CES Guardian (chat + embeddings para la base de conocimiento).
# Se lee en tiempo de ejecución (src/routes/api/chat.ts) y en el script de ingesta (scripts/ingest-knowledge.mjs).
OPENAI_API_KEY=

# Autenticación con Microsoft Entra ID (Azure AD). Ver App Registration en portal.azure.com.
# Client ID / Tenant ID no son secretos; el Client Secret SÍ lo es — nunca lo commitees ni lo compartas.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Debe coincidir EXACTO con un Redirect URI configurado en Azure (plataforma "Web").
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Origen público de la app (sin slash final) — usado para el logout y validar el callback.
APP_ORIGIN=http://localhost:3000

# Secreto usado para cifrar/firmar las cookies de sesión (login y estado OAuth). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Connection string de Postgres usada para persistir los datos sincronizados desde n8n (clientes,
# contratos). Sin esto, /api/sync/clientes cae al fallback estático de ces-data.ts.
# Si conectaste la integración Vercel↔Neon, Vercel ya inyecta POSTGRES_URL automáticamente — no
# necesitas llenar esto en producción. Para correr localmente, copia aquí el valor de POSTGRES_URL
# desde el dashboard de Vercel (Settings → Environment Variables).
DATABASE_URL=

# Secreto compartido para validar el POST de n8n a /api/sync/clientes (header x-sync-secret). Opcional
# pero recomendado en producción.
SYNC_SECRET=
